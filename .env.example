# Copy to .env (git-ignored) and fill in. docker compose reads this file automatically.

# --- Database (docker compose creates this database/user on first start) -------------
DB_NAME=pos
DB_USER=pos
# Local-development default. Use a strong value anywhere else.
DB_PASSWORD=pos

# --- JWT signing key (REQUIRED, no default) --------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime in milliseconds (default 24h)
# JWT_EXPIRATION_MS=86400000

# --- First administrator (optional) -----------------------------------------------------
# Created at startup if no account with this email exists. The password must be at least
# 12 characters and is stored as a BCrypt hash. Existing accounts are never modified.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# --- CORS (comma-separated origins allowed to call the API from a browser) ------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Pricing, tax and discounts ---------------------------------------------------------
# Percentages. Prices are tax-EXCLUSIVE unless TAX_PRICES_INCLUDE_TAX=true. 0 means "no tax".
# Rates are looked up by each product's tax class (STANDARD, ZERO); anything else uses the default.
# Set these to whatever applies where you operate - nothing here is legal or tax advice.
# TAX_DEFAULT_RATE_PERCENT=0
# TAX_STANDARD_RATE_PERCENT=0
# TAX_PRICES_INCLUDE_TAX=false
# Highest order discount each role may give at checkout
# DISCOUNT_CASHIER_MAX_PERCENT=15
# DISCOUNT_MANAGER_MAX_PERCENT=50
# DISCOUNT_ADMIN_MAX_PERCENT=100

# --- Receipt header/footer ----------------------------------------------------------------
# STORE_NAME=Stockora Supermarket
# STORE_ADDRESS=
# STORE_PHONE=
# STORE_TAX_ID=
# STORE_RECEIPT_FOOTER=Thank you for shopping with us!
